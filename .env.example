# Активный движок: gemini (основной), ollama (локальный Qwen), qwen (Hugging Face), openrouter (запасной)
AI_PROVIDER=gemini
# OpenRouter (запасной): бесплатный ключ https://openrouter.ai/keys
# модель — актуальную бесплатную :free с vision смотреть тут: https://openrouter.ai/models
OPENROUTER_KEY=
# Маленькая (дешёвая/быстрая) и большая (умная) — вторая подхватывает, если первая отказала
OPENROUTER_MODEL=thinkingmachines/inkling-small:free
OPENROUTER_MODEL_FALLBACK=google/gemma-4-26b-a4b-it:free
# Ollama: адрес и цепочка моделей (лёгкая → мощная).
# Включается только при AI_PROVIDER=ollama (после переезда в датацентр).
# Мощная открытая: qwen3-vl:30b (30B total / 3B active MoE, ~20 ГБ: ollama pull qwen3-vl:30b)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:2b-instruct
OLLAMA_MODEL_FALLBACK=qwen3-vl:30b
# Токен Hugging Face (бесплатно: huggingface.co → Settings → Access Tokens → New token)
HF_TOKEN=
# Получить: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Необязательно: переопределить цепочку моделей
# (по умолчанию: gemini-flash-latest -> gemini-flash-lite-latest -> gemini-2.5-flash)
GEMINI_MODEL=
